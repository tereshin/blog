{
  "name": "media-service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx ../../infra/scripts/with-host-env.ts media -- tsx watch src/main.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:contract": "vitest run --passWithNoTests test/contract",
    "test:unit": "vitest run --passWithNoTests --exclude '**/integration/**' --exclude '**/e2e/**'",
    "test:integration": "vitest run --passWithNoTests test/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@blog/config": "workspace:^",
    "@blog/contracts": "workspace:^",
    "@blog/db-kit": "workspace:^",
    "@blog/errors": "workspace:^",
    "@blog/http-kit": "workspace:^",
    "@blog/logger": "workspace:^",
    "@blog/seed-data": "workspace:^",
    "@blog/telemetry": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "file-type": "^21.3.4",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}
