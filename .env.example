# Local PostgreSQL started by docker-compose.yml.
# POSTGRES_PORT is the host port. Use another port when 5432 is already taken.
POSTGRES_PORT=5432
DATABASE_URL=postgres://blog:blog@127.0.0.1:5432/blog

# Redis 8, RabbitMQ, and MinIO from docker-compose.yml.
# Change the host ports when the defaults are already taken.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://blog:blog@127.0.0.1:5672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=blog
MINIO_SECRET_KEY=blogblogblog
