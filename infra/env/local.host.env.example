# Шаблон окружения local (с хоста). Скопируйте в infra/env/local (с хоста).env (файл в .gitignore) и замените CHANGE_ME.
# Пары ключей служебного JWT (Ed25519, PEM в одну строку с литералами \n):
#   openssl genpkey -algorithm ed25519 -out jwt.key && openssl pkey -in jwt.key -pubout -out jwt.pub
#   awk 'NF {printf "%s\\n", $0}' jwt.key   # значение SERVICE_JWT_PRIVATE_KEY
#   awk 'NF {printf "%s\\n", $0}' jwt.pub   # значение SERVICE_JWT_PUBLIC_KEY
# Пароли баз и ключи MinIO: openssl rand -hex 24
APP_ENV=local

# --- PostgreSQL: пароль каждой из шести баз ---
IDENTITY_DB_PASSWORD=CHANGE_ME
CONTENT_DB_PASSWORD=CHANGE_ME
DISCUSSION_DB_PASSWORD=CHANGE_ME
MESSAGING_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
MEDIA_DB_PASSWORD=CHANGE_ME

# Адреса баз с хоста (для `pnpm --filter <service> dev`; порты опубликованы окружением local)
IDENTITY_DATABASE_URL=postgres://identity:CHANGE_ME@localhost:5433/identity
CONTENT_DATABASE_URL=postgres://content:CHANGE_ME@localhost:5434/content
DISCUSSION_DATABASE_URL=postgres://discussion:CHANGE_ME@localhost:5435/discussion
MESSAGING_DATABASE_URL=postgres://messaging:CHANGE_ME@localhost:5436/messaging
NOTIFICATION_DATABASE_URL=postgres://notification:CHANGE_ME@localhost:5437/notification
MEDIA_DATABASE_URL=postgres://media:CHANGE_ME@localhost:5438/media

# --- NATS ---
NATS_URL=nats://localhost:4222

# --- MinIO / S3 ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=media
# Публичный адрес файлов: его же seed вписывает в аватары и блоки статей
S3_PUBLIC_URL=http://localhost:9000/media
S3_REGION=us-east-1
# Совпадают с MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- Служебный JWT между gateway и сервисами ---
SERVICE_JWT_PRIVATE_KEY=CHANGE_ME
SERVICE_JWT_PUBLIC_KEY=CHANGE_ME

# --- Firebase Authentication (читает только identity-service). Секреты — заглушки ---
FIREBASE_PROJECT_ID=demo-blog
FIREBASE_AUTH_DOMAIN=CHANGE_ME
FIREBASE_WEB_API_KEY=CHANGE_ME
FIREBASE_SERVER_API_KEY=CHANGE_ME
FIREBASE_CLIENT_EMAIL=CHANGE_ME
FIREBASE_PRIVATE_KEY=CHANGE_ME
# Эмулятор Auth на хосте, порт 9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
SEED_AUTH_PASSWORD=CHANGE_ME

# --- Адреса сервисов, запущенных с хоста (порты по умолчанию) ---
IDENTITY_URL=http://localhost:3001
CONTENT_URL=http://localhost:3002
DISCUSSION_URL=http://localhost:3003
MESSAGING_URL=http://localhost:3004
NOTIFICATION_URL=http://localhost:3005
MEDIA_URL=http://localhost:3006
SESSION_COOKIE_NAME=blog_session
GUEST_COOKIE_NAME=blog_guest
CSRF_COOKIE_NAME=blog_csrf

# --- Площадка ---
SUPERADMIN_EMAIL=superadmin@blog.test
SESSION_TTL_DAYS=30
PUBLIC_ORIGIN=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
# Адрес gateway для клиента; в prod пустой — один origin
VITE_API_BASE_URL=http://localhost:3000
