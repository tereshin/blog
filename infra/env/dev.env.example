# Шаблон окружения dev. Скопируйте в infra/env/dev.env (файл в .gitignore) и замените CHANGE_ME.
# Пары ключей служебного JWT (Ed25519, PEM в одну строку с литералами \n):
#   openssl genpkey -algorithm ed25519 -out jwt.key && openssl pkey -in jwt.key -pubout -out jwt.pub
#   awk 'NF {printf "%s\\n", $0}' jwt.key   # значение SERVICE_JWT_PRIVATE_KEY
#   awk 'NF {printf "%s\\n", $0}' jwt.pub   # значение SERVICE_JWT_PUBLIC_KEY
# Пароли баз и ключи MinIO: openssl rand -hex 24
APP_ENV=dev

# --- PostgreSQL: пароль каждой из шести баз ---
IDENTITY_DB_PASSWORD=CHANGE_ME
CONTENT_DB_PASSWORD=CHANGE_ME
DISCUSSION_DB_PASSWORD=CHANGE_ME
MESSAGING_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
MEDIA_DB_PASSWORD=CHANGE_ME

# --- NATS ---
NATS_URL=nats://nats:4222

# --- MinIO / S3 ---
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://minio:9000
S3_BUCKET=media
# Публичный адрес файлов: его же seed вписывает в аватары и блоки статей
S3_PUBLIC_URL=http://localhost:9000/media
S3_REGION=us-east-1

# --- Служебный JWT между gateway и сервисами ---
SERVICE_JWT_PRIVATE_KEY=CHANGE_ME
SERVICE_JWT_PUBLIC_KEY=CHANGE_ME

# --- Firebase Authentication (читает только identity-service). Секреты — заглушки ---
FIREBASE_PROJECT_ID=demo-blog
FIREBASE_AUTH_DOMAIN=CHANGE_ME
FIREBASE_WEB_API_KEY=CHANGE_ME
FIREBASE_SERVER_API_KEY=CHANGE_ME
FIREBASE_CLIENT_EMAIL=CHANGE_ME
FIREBASE_PRIVATE_KEY=CHANGE_ME
# Эмулятор Auth только в local и dev. Имя *.localhost открывается и браузером, и контейнером identity.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth.localhost:9099
SEED_AUTH_PASSWORD=CHANGE_ME

# --- Площадка ---
SUPERADMIN_EMAIL=CHANGE_ME
SESSION_TTL_DAYS=30
PUBLIC_ORIGIN=https://dev.example.com
WEB_ORIGIN=https://dev.example.com
# Адрес gateway для клиента; в prod пустой — один origin
VITE_API_BASE_URL=https://dev.example.com

# --- Образы ---
REGISTRY=CHANGE_ME
IMAGE_TAG=CHANGE_ME
