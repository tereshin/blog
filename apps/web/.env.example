# Адрес gateway. Пусто — тот же origin (prod); в dev запросы идут через прокси Vite на localhost:3000.
VITE_API_BASE_URL=
# 1 — клиент работает против фикстурного gateway (MSW), без сервисов.
VITE_API_MOCK=
# Имя cookie с CSRF-токеном (совпадает с CSRF_COOKIE_NAME у gateway).
VITE_CSRF_COOKIE_NAME=blog_csrf
